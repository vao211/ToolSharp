<Window x:Class="MyWidget.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:MyWidget.Services"
        xmlns:vm="clr-namespace:MyWidget.ViewModels"
        Title="{loc:Loc AppWindowTitle}"
        Width="980"
        Height="660"
        MinWidth="760"
        MinHeight="500"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource ForegroundBrush}">

    <Window.Resources>
        <!-- Sidebar Nav Button -->
        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryForegroundBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{DynamicResource ControlCornerRadius}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlHoverBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Settings Section Card -->
        <Style x:Key="SettingsCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource CardCornerRadius}" />
            <Setter Property="Padding" Value="18,16" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- LEFT SIDEBAR -->
        <Border Grid.Column="0"
                Background="{DynamicResource SidebarBackgroundBrush}"
                BorderBrush="{DynamicResource SubtleBorderBrush}"
                BorderThickness="0,0,1,0"
                Padding="16">
            <DockPanel LastChildFill="True">
                <!-- App Brand -->
                <StackPanel DockPanel.Dock="Top" Margin="0,2,0,16">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="34"
                                Height="34"
                                CornerRadius="{DynamicResource ControlCornerRadius}"
                                Background="{DynamicResource AccentBrush}"
                                Margin="0,0,10,0">
                            <TextBlock Text="📝"
                                       FontSize="17"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="MyWidget"
                                       FontSize="17"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource ForegroundBrush}" />
                            <TextBlock Text="{loc:Loc AppSubtitle}"
                                       FontSize="11.5"
                                       Foreground="{DynamicResource SecondaryForegroundBrush}"
                                       Visibility="{DynamicResource DescVisibility}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Create New Note CTA -->
                    <Button Style="{StaticResource PrimaryButtonStyle}"
                            Margin="0,16,0,0"
                            Padding="14,10"
                            Command="{Binding CreateNoteCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="＋ " FontWeight="Bold" />
                            <TextBlock Text="{loc:Loc BtnNewNote}" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Bottom Sidebar Actions -->
                <StackPanel DockPanel.Dock="Bottom">
                    <Border Height="1" Background="{DynamicResource SubtleBorderBrush}" Margin="0,8,0,10" />

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Padding="6,6"
                                FontSize="12"
                                Content="{loc:Loc BtnShowAll}"
                                Command="{Binding ShowAllNotesCommand}" />
                        <Button Grid.Column="2"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Padding="6,6"
                                FontSize="12"
                                Content="{loc:Loc BtnHideAll}"
                                Command="{Binding HideAllNotesCommand}" />
                    </Grid>

                    <!-- Quick Theme Switch -->
                    <Button Style="{StaticResource SecondaryButtonStyle}"
                            Margin="0,0,0,8"
                            Padding="10,7"
                            Command="{Binding ToggleThemeCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🌓 " />
                            <TextBlock Text="{loc:Loc BtnSwitchTheme}" />
                        </StackPanel>
                    </Button>

                    <!-- Exit Application -->
                    <Button Style="{StaticResource DangerSubtleButtonStyle}"
                            Padding="10,7"
                            Command="{Binding QuitAppCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⏻ " />
                            <TextBlock Text="{loc:Loc BtnQuitApp}" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Nav Menu -->
                <StackPanel>
                    <!-- Notes Nav -->
                    <Button Command="{Binding SwitchToNotesCommand}" Margin="0,0,0,4">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsNotesTab}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <DockPanel>
                            <Border DockPanel.Dock="Right"
                                    CornerRadius="{DynamicResource SmallCornerRadius}"
                                    Padding="7,1"
                                    Background="{DynamicResource ControlHoverBrush}">
                                <TextBlock Text="{Binding TotalNotesCount}"
                                           FontSize="11.5"
                                           Foreground="{DynamicResource ForegroundBrush}" />
                            </Border>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📌  " />
                                <TextBlock Text="{loc:Loc NavNotes}" />
                            </StackPanel>
                        </DockPanel>
                    </Button>

                    <!-- Settings Nav -->
                    <Button Command="{Binding SwitchToSettingsCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSettingsTab}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚙  " />
                            <TextBlock Text="{loc:Loc NavSettings}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- RIGHT MAIN CONTENT -->
        <Grid Grid.Column="1">

            <!-- ========================================= -->
            <!-- TAB 1: NOTES DASHBOARD                    -->
            <!-- ========================================= -->
            <Grid Visibility="{Binding IsNotesTab, Converter={StaticResource BoolToVis}}"
                  Margin="22,18,22,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Page Header -->
                <DockPanel Grid.Row="0" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc HeaderMyNotes}"
                                   FontSize="22"
                                   FontWeight="Bold" />
                        <TextBlock Text="{loc:Loc HeaderMyNotesDesc}"
                                   Style="{StaticResource DescTextStyle}"
                                   FontSize="12.5" />
                    </StackPanel>
                </DockPanel>

                <!-- Search & Filter Bar -->
                <Grid Grid.Row="1" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Search Box -->
                    <Grid Grid.Column="0">
                        <TextBox Style="{StaticResource ModernTextBoxStyle}"
                                 Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="32,8,30,8" />
                        <TextBlock Text="🔍"
                                   IsHitTestVisible="False"
                                   VerticalAlignment="Center"
                                   Margin="11,0,0,0"
                                   FontSize="12.5"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}" />
                        <TextBlock Text="{loc:Loc PlaceholderSearchNotes}"
                                   IsHitTestVisible="False"
                                   VerticalAlignment="Center"
                                   Margin="34,0,0,0"
                                   FontSize="13"
                                   Foreground="{DynamicResource MutedForegroundBrush}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SearchQuery}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Button HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Margin="0,0,6,0"
                                Style="{StaticResource GhostIconButtonStyle}"
                                Content="✕"
                                FontSize="11"
                                Visibility="{Binding HasSearchQuery, Converter={StaticResource BoolToVis}}"
                                Command="{Binding ClearSearchCommand}" />
                    </Grid>

                    <!-- Filter Segmented Pills -->
                    <Border Grid.Column="2"
                            Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource ControlBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource ControlCornerRadius}"
                            Padding="3">
                        <StackPanel Orientation="Horizontal">
                            <Button Padding="10,5" BorderThickness="0" Cursor="Hand"
                                    Foreground="{DynamicResource SecondaryForegroundBrush}"
                                    Command="{Binding SetFilterAllCommand}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd" CornerRadius="{DynamicResource SmallCornerRadius}" Padding="{TemplateBinding Padding}" Background="Transparent">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{loc:Loc FilterAll}" FontSize="12.5" />
                                                <TextBlock Text=" (" FontSize="12" Opacity="0.7" />
                                                <TextBlock Text="{Binding TotalNotesCount}" FontSize="12" Opacity="0.7" />
                                                <TextBlock Text=")" FontSize="12" Opacity="0.7" />
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsFilterAll}" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <Button Padding="10,5" BorderThickness="0" Cursor="Hand"
                                    Foreground="{DynamicResource SecondaryForegroundBrush}"
                                    Command="{Binding SetFilterOpenCommand}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd" CornerRadius="{DynamicResource SmallCornerRadius}" Padding="{TemplateBinding Padding}" Background="Transparent">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{loc:Loc FilterPinnedOpen}" FontSize="12.5" />
                                                <TextBlock Text=" (" FontSize="12" Opacity="0.7" />
                                                <TextBlock Text="{Binding OpenNotesCount}" FontSize="12" Opacity="0.7" />
                                                <TextBlock Text=")" FontSize="12" Opacity="0.7" />
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsFilterOpen}" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <Button Padding="10,5" BorderThickness="0" Cursor="Hand"
                                    Foreground="{DynamicResource SecondaryForegroundBrush}"
                                    Command="{Binding SetFilterHiddenCommand}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd" CornerRadius="{DynamicResource SmallCornerRadius}" Padding="{TemplateBinding Padding}" Background="Transparent">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{loc:Loc FilterHidden}" FontSize="12.5" />
                                                <TextBlock Text=" (" FontSize="12" Opacity="0.7" />
                                                <TextBlock Text="{Binding HiddenNotesCount}" FontSize="12" Opacity="0.7" />
                                                <TextBlock Text=")" FontSize="12" Opacity="0.7" />
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsFilterHidden}" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Notes Cards Grid -->
                <Grid Grid.Row="2">
                    <!-- Empty State -->
                    <Border Visibility="{Binding HasNoFilteredNotes, Converter={StaticResource BoolToVis}}"
                            Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource SubtleBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource CardCornerRadius}"
                            Padding="32"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="🗒" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,10" />
                            <TextBlock Text="{loc:Loc EmptyNotesListTitle}"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="{loc:Loc EmptyNotesListDesc}"
                                       FontSize="12.5"
                                       Foreground="{DynamicResource SecondaryForegroundBrush}"
                                       HorizontalAlignment="Center"
                                       Margin="0,4,0,14" />
                            <Button Style="{StaticResource PrimaryButtonStyle}"
                                     HorizontalAlignment="Center"
                                    Content="{loc:Loc BtnNewNote}"
                                    Command="{Binding CreateNoteCommand}" />
                        </StackPanel>
                    </Border>

                    <ScrollViewer Visibility="{Binding HasNoFilteredNotes, Converter={StaticResource InvBoolToVis}}"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding FilteredNotes}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:NoteViewModel}">
                                    <Border Width="222"
                                            Height="194"
                                            Margin="0,0,14,14"
                                            CornerRadius="{DynamicResource CardCornerRadius}"
                                            Background="{Binding Palette.SurfaceBrush}"
                                            BorderBrush="{Binding Palette.BorderBrush}"
                                            BorderThickness="1"
                                            Cursor="Hand"
                                            AllowDrop="True"
                                            MouseLeftButtonDown="NoteCard_OnMouseLeftButtonDown"
                                            PreviewMouseMove="NoteCard_OnPreviewMouseMove"
                                            DragOver="NoteCard_OnDragOver"
                                            Drop="NoteCard_OnDrop">
                                        <Border.ContextMenu>
                                            <ContextMenu Opened="NoteCardContextMenu_OnOpened">
                                                <MenuItem Header="{loc:Loc BtnPinShow}" Command="{Binding ShowNoteCommand}" />
                                                <MenuItem Header="{loc:Loc BtnCenterOnScreen}" Command="{Binding CenterOnScreenCommand}" />
                                                <MenuItem Header="{loc:Loc BtnHideNote}" Command="{Binding HideNoteCommand}" />
                                                <Separator />
                                                <MenuItem Header="{loc:Loc BtnDuplicateNote}" Command="{Binding DuplicateNoteCommand}" />
                                                <MenuItem Header="{loc:Loc BtnDeleteNote}"
                                                          Foreground="{DynamicResource DangerBrush}"
                                                          Command="{Binding DeleteNoteCommand}" />
                                            </ContextMenu>
                                        </Border.ContextMenu>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="34" />
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <!-- Card Colored Top Strip -->
                                            <Border Grid.Row="0"
                                                    Background="{Binding Palette.HeaderBrush}"
                                                    CornerRadius="{DynamicResource NoteHeaderCornerRadius}"
                                                    Padding="10,0">
                                                <DockPanel>
                                                    <StackPanel DockPanel.Dock="Right"
                                                                Orientation="Horizontal"
                                                                VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding PinModeIcon}"
                                                                   FontSize="11.5"
                                                                   ToolTip="{Binding PinModeLabel}"
                                                                   Margin="4,0,0,0" />
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding DisplayTitle}"
                                                               FontWeight="SemiBold"
                                                               FontSize="13"
                                                               Foreground="{Binding Palette.HeaderForegroundBrush}"
                                                               VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis" />
                                                </DockPanel>
                                            </Border>

                                            <!-- Card Summary Body -->
                                            <TextBlock Grid.Row="1"
                                                       Margin="10,8,10,6"
                                                       Text="{Binding PreviewSummary}"
                                                       Foreground="{Binding Palette.ForegroundBrush}"
                                                       FontSize="12.5"
                                                       TextWrapping="Wrap"
                                                       TextTrimming="CharacterEllipsis" />

                                            <!-- Card Footer Badges + Quick Actions -->
                                            <Border Grid.Row="2"
                                                    Padding="8,6"
                                                    BorderBrush="{Binding Palette.BorderBrush}"
                                                    BorderThickness="0,1,0,0">
                                                <DockPanel>
                                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                        <Button Style="{StaticResource GhostIconButtonStyle}"
                                                                Padding="5,2"
                                                                FontSize="11.5"
                                                                ToolTip="{loc:Loc TooltipToggleShowHide}"
                                                                Command="{Binding ToggleOpenCommand}">
                                                            <TextBlock FontSize="11.5"
                                                                       Foreground="{Binding Palette.ForegroundBrush}">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Text" Value="{loc:Loc BtnPinShow}" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsOpen}" Value="True">
                                                                                <Setter Property="Text" Value="{loc:Loc BtnHideShort}" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Button>
                                                        <Button Style="{StaticResource GhostIconButtonStyle}"
                                                                Padding="5,2"
                                                                Content="⧉"
                                                                Foreground="{Binding Palette.ForegroundBrush}"
                                                                ToolTip="{loc:Loc BtnDuplicateNote}"
                                                                Command="{Binding DuplicateNoteCommand}" />
                                                        <Button Style="{StaticResource DangerSubtleButtonStyle}"
                                                                Padding="5,2"
                                                                Content="🗑"
                                                                ToolTip="{loc:Loc BtnDeleteNote}"
                                                                Command="{Binding DeleteNoteCommand}" />
                                                    </StackPanel>

                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding CheckStatsText}"
                                                                   Visibility="{Binding HasChecks, Converter={StaticResource BoolToVis}}"
                                                                   FontSize="11"
                                                                   Foreground="{Binding Palette.SecondaryForegroundBrush}"
                                                                   Margin="0,0,6,0" />
                                                        <TextBlock Text="{Binding ImageStatsText}"
                                                                   Visibility="{Binding HasImages, Converter={StaticResource BoolToVis}}"
                                                                   FontSize="11"
                                                                   Foreground="{Binding Palette.SecondaryForegroundBrush}"
                                                                   Margin="0,0,6,0" />
                                                        <TextBlock Text="{Binding UpdatedTimeText}"
                                                                   FontSize="10.5"
                                                                   Foreground="{Binding Palette.SecondaryForegroundBrush}" />
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <!-- ========================================= -->
            <!-- TAB 2: SETTINGS                           -->
            <!-- ========================================= -->
            <ScrollViewer Visibility="{Binding IsSettingsTab, Converter={StaticResource BoolToVis}}"
                          VerticalScrollBarVisibility="Auto"
                          Padding="24,18,24,24">
                <StackPanel MaxWidth="680" HorizontalAlignment="Left">
                    <StackPanel Margin="0,0,0,16">
                        <TextBlock Text="{loc:Loc NavSettings}"
                                   FontSize="22"
                                   FontWeight="Bold" />
                        <TextBlock Text="{loc:Loc HeaderSettingsDesc}"
                                   Style="{StaticResource DescTextStyle}"
                                   FontSize="12.5" />
                    </StackPanel>

                    <!-- Status Banner -->
                    <Border Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolToVis}}"
                            Background="{DynamicResource AccentSoftBrush}"
                            BorderBrush="{DynamicResource AccentBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource ControlCornerRadius}"
                            Padding="12,8"
                            Margin="0,0,0,14">
                        <TextBlock Text="{Binding StatusMessage}"
                                   FontSize="12.5"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource ForegroundBrush}" />
                    </Border>

                    <!-- 1. APPEARANCE & ACCENT COLOR -->
                    <Border Style="{StaticResource SettingsCardStyle}">
                        <StackPanel>
                            <TextBlock Text="{loc:Loc SectionAppearance}"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       Margin="0,0,0,12" />

                            <!-- Light / Dark Mode Row -->
                            <DockPanel Margin="0,0,0,14">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource SecondaryButtonStyle}"
                                            Padding="12,5"
                                            Margin="0,0,6,0"
                                            Content="{loc:Loc ThemeLight}"
                                            Command="{Binding SetLightModeCommand}" />
                                    <Button Style="{StaticResource SecondaryButtonStyle}"
                                            Padding="12,5"
                                            Margin="0,0,10,0"
                                            Content="{loc:Loc ThemeDark}"
                                            Command="{Binding SetDarkModeCommand}" />
                                    <CheckBox Style="{StaticResource ToggleSwitchStyle}"
                                              IsChecked="{Binding IsDarkMode, Mode=TwoWay}" />
                                </StackPanel>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="{loc:Loc LabelDarkMode}" FontWeight="SemiBold" FontSize="13.5" />
                                    <TextBlock Text="{loc:Loc DescDarkMode}" Style="{StaticResource DescTextStyle}" />
                                </StackPanel>
                            </DockPanel>

                            <Border Height="1" Background="{DynamicResource SubtleBorderBrush}" Margin="0,0,0,14" />

                            <!-- Show / Hide Helper Descriptions Toggle -->
                            <DockPanel Margin="0,0,0,14">
                                <CheckBox DockPanel.Dock="Right"
                                          Style="{StaticResource ToggleSwitchStyle}"
                                          IsChecked="{Binding ShowDescriptions, Mode=TwoWay}" />
                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="{loc:Loc LabelShowDescriptions}" FontWeight="SemiBold" FontSize="13.5" />
                                    <TextBlock Text="{loc:Loc DescShowDescriptions}" Style="{StaticResource DescTextStyle}" />
                                </StackPanel>
                            </DockPanel>

                            <Border Height="1" Background="{DynamicResource SubtleBorderBrush}" Margin="0,0,0,14" />

                            <!-- UI Corner Radius (Square 0px -> Rounded 24px) -->
                            <StackPanel Margin="0,0,0,14">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                                Padding="8,4"
                                                FontSize="11.5"
                                                Margin="0,0,4,0"
                                                Content="{loc:Loc CornerPresetSquare}"
                                                Command="{Binding SetCornerPresetCommand}"
                                                CommandParameter="0" />
                                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                                Padding="8,4"
                                                FontSize="11.5"
                                                Margin="0,0,4,0"
                                                Content="{loc:Loc CornerPresetSharp}"
                                                Command="{Binding SetCornerPresetCommand}"
                                                CommandParameter="6" />
                                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                                Padding="8,4"
                                                FontSize="11.5"
                                                Margin="0,0,4,0"
                                                Content="{loc:Loc CornerPresetDefault}"
                                                Command="{Binding SetCornerPresetCommand}"
                                                CommandParameter="12" />
                                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                                Padding="8,4"
                                                FontSize="11.5"
                                                Margin="0,0,8,0"
                                                Content="{loc:Loc CornerPresetRound}"
                                                Command="{Binding SetCornerPresetCommand}"
                                                CommandParameter="20" />
                                        <Border Background="{DynamicResource AccentSoftBrush}"
                                                CornerRadius="{DynamicResource SmallCornerRadius}"
                                                Padding="8,3"
                                                MinWidth="46">
                                            <TextBlock Text="{Binding CornerRadiusText}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Center"
                                                       Foreground="{DynamicResource AccentBrush}" />
                                        </Border>
                                    </StackPanel>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock Text="{loc:Loc LabelCornerRadius}" FontWeight="SemiBold" FontSize="13.5" />
                                        <TextBlock Text="{loc:Loc DescCornerRadius}" Style="{StaticResource DescTextStyle}" />
                                    </StackPanel>
                                </DockPanel>

                                <Slider Minimum="0"
                                        Maximum="24"
                                        TickFrequency="1"
                                        IsSnapToTickEnabled="True"
                                        Margin="0,10,0,0"
                                        Value="{Binding CornerRadius, Mode=TwoWay}" />
                            </StackPanel>

                            <Border Height="1" Background="{DynamicResource SubtleBorderBrush}" Margin="0,0,0,14" />

                            <!-- App Accent Color -->
                            <TextBlock Text="{loc:Loc LabelAppAccentColor}"
                                       FontWeight="SemiBold"
                                       FontSize="13.5" />
                            <TextBlock Text="{loc:Loc DescAppAccentColor}"
                                       Style="{StaticResource DescTextStyle}" />

                            <ItemsControl ItemsSource="{Binding AppAccentSwatches}" Margin="0,10,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:ColorSwatchItem}">
                                        <Button Width="34"
                                                Height="34"
                                                Margin="0,0,8,8"
                                                Cursor="Hand"
                                                ToolTip="{Binding ColorHex}"
                                                Command="{Binding DataContext.SelectAppAccentCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Grid>
                                                        <Ellipse Width="28"
                                                                 Height="28"
                                                                 Fill="{Binding PreviewBrush}" />
                                                        <Ellipse Width="34"
                                                                 Height="34"
                                                                 Stroke="{DynamicResource ForegroundBrush}"
                                                                 StrokeThickness="2"
                                                                 Visibility="{Binding IsSelected, Converter={StaticResource BoolToVis}}" />
                                                    </Grid>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Custom App Accent Hex -->
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,14">
                                <TextBox Style="{StaticResource ModernTextBoxStyle}"
                                         Width="130"
                                         Text="{Binding CustomAppAccentHex, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Style="{StaticResource SecondaryButtonStyle}"
                                        Margin="8,0,0,0"
                                        Content="{loc:Loc BtnApplyHex}"
                                        Command="{Binding ApplyCustomAppAccentCommand}" />
                            </StackPanel>

                            <Border Height="1" Background="{DynamicResource SubtleBorderBrush}" Margin="0,0,0,14" />

                            <!-- Default Note Color & Pin Mode -->
                            <TextBlock Text="{loc:Loc LabelDefaultNoteColor}"
                                       FontWeight="SemiBold"
                                       FontSize="13.5"
                                       Margin="0,0,0,8" />

                            <ItemsControl ItemsSource="{Binding DefaultNoteSwatches}" Margin="0,0,0,12">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:ColorSwatchItem}">
                                        <Button Width="32"
                                                Height="32"
                                                Margin="0,0,8,8"
                                                Cursor="Hand"
                                                Command="{Binding DataContext.SelectDefaultNoteColorCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Grid>
                                                        <Ellipse Width="26"
                                                                 Height="26"
                                                                 Fill="{Binding PreviewBrush}"
                                                                 Stroke="{DynamicResource ControlBorderBrush}"
                                                                 StrokeThickness="1" />
                                                        <Ellipse Width="32"
                                                                 Height="32"
                                                                 Stroke="{DynamicResource ForegroundBrush}"
                                                                 StrokeThickness="2"
                                                                 Visibility="{Binding IsSelected, Converter={StaticResource BoolToVis}}" />
                                                        <TextBlock Text="A"
                                                                   FontSize="10"
                                                                   FontWeight="Bold"
                                                                   Foreground="#FFFFFF"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"
                                                                   Visibility="{Binding IsFollowAppAccent, Converter={StaticResource BoolToVis}}" />
                                                    </Grid>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <DockPanel>
                                <ComboBox DockPanel.Dock="Right"
                                          Width="210"
                                          Style="{StaticResource ModernComboBoxStyle}"
                                          SelectedIndex="{Binding DefaultPinModeIndex, Mode=TwoWay}">
                                    <ComboBoxItem Content="{loc:Loc PinModeDesktop}" />
                                    <ComboBoxItem Content="{loc:Loc PinModeTopmost}" />
                                    <ComboBoxItem Content="{loc:Loc PinModeNormal}" />
                                </ComboBox>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="{loc:Loc LabelDefaultPinMode}" FontWeight="SemiBold" FontSize="13.5" />
                                    <TextBlock Text="{loc:Loc DescDefaultPinMode}" Style="{StaticResource DescTextStyle}" />
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <!-- 2. STARTUP & SYSTEM BEHAVIOR -->
                    <Border Style="{StaticResource SettingsCardStyle}">
                        <StackPanel>
                            <TextBlock Text="{loc:Loc SectionStartupSystem}"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       Margin="0,0,0,12" />

                            <DockPanel Margin="0,0,0,14">
                                <CheckBox DockPanel.Dock="Right"
                                          Style="{StaticResource ToggleSwitchStyle}"
                                          IsChecked="{Binding StartWithWindows, Mode=TwoWay}" />
                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="{loc:Loc LabelStartWithWindows}" FontWeight="SemiBold" FontSize="13.5" />
                                    <TextBlock Text="{loc:Loc DescStartWithWindows}" Style="{StaticResource DescTextStyle}" />
                                </StackPanel>
                            </DockPanel>

                            <Border Height="1" Background="{DynamicResource SubtleBorderBrush}" Margin="0,0,0,14" />

                            <DockPanel>
                                <CheckBox DockPanel.Dock="Right"
                                          Style="{StaticResource ToggleSwitchStyle}"
                                          IsChecked="{Binding HideToTrayOnClose, Mode=TwoWay}" />
                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="{loc:Loc LabelHideToTray}" FontWeight="SemiBold" FontSize="13.5" />
                                    <TextBlock Text="{loc:Loc DescHideToTray}" Style="{StaticResource DescTextStyle}" />
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <!-- 3. IMAGE RESOURCES & DATA STORAGE -->
                    <Border Style="{StaticResource SettingsCardStyle}">
                        <StackPanel>
                            <TextBlock Text="{loc:Loc SectionResourcesData}"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       Margin="0,0,0,12" />

                            <DockPanel Margin="0,0,0,14">
                                <CheckBox DockPanel.Dock="Right"
                                          Style="{StaticResource ToggleSwitchStyle}"
                                          IsChecked="{Binding CopyImagesToAppData, Mode=TwoWay}" />
                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="{loc:Loc LabelCopyImagesToAppData}" FontWeight="SemiBold" FontSize="13.5" />
                                    <TextBlock Text="{loc:Loc DescCopyImagesToAppData}" Style="{StaticResource DescTextStyle}" />
                                </StackPanel>
                            </DockPanel>

                            <Border Background="{DynamicResource SurfaceElevatedBrush}"
                                    CornerRadius="{DynamicResource ControlCornerRadius}"
                                    Padding="10,8"
                                    Margin="0,0,0,12">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Padding="10,5"
                                            FontSize="12"
                                            Content="{loc:Loc BtnOpenDataFolder}"
                                            Command="{Binding OpenDataFolderCommand}" />
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                                        <TextBlock Text="{loc:Loc LabelDataFolder}"
                                                   FontSize="11.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource SecondaryForegroundBrush}" />
                                        <TextBlock Text="{Binding DataFolderPath, Mode=OneWay}"
                                                   FontSize="12"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <WrapPanel>
                                <Button Style="{StaticResource SecondaryButtonStyle}"
                                        Margin="0,0,8,4"
                                        Content="{loc:Loc BtnMigrateExternalImages}"
                                        Command="{Binding MigrateExternalImagesCommand}" />
                                <Button Style="{StaticResource SecondaryButtonStyle}"
                                        Margin="0,0,0,4"
                                        Content="{loc:Loc BtnCleanUnusedMedia}"
                                        Command="{Binding CleanUnusedMediaCommand}" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- 4. LANGUAGE & LOCALIZATION (lang/*.json) -->
                    <Border Style="{StaticResource SettingsCardStyle}">
                        <StackPanel>
                            <TextBlock Text="{loc:Loc SectionLanguage}"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       Margin="0,0,0,12" />

                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <ComboBox Width="180"
                                              Style="{StaticResource ModernComboBoxStyle}"
                                              ItemsSource="{Binding AvailableLanguages}"
                                              SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}"
                                              DisplayMemberPath="DisplayName" />
                                    <Button Style="{StaticResource SecondaryButtonStyle}"
                                            Margin="8,0,0,0"
                                            Padding="10,7"
                                            ToolTip="{loc:Loc BtnReloadLanguages}"
                                            Content="↻"
                                            Command="{Binding ReloadLanguagesCommand}" />
                                    <Button Style="{StaticResource SecondaryButtonStyle}"
                                            Margin="8,0,0,0"
                                            Padding="10,7"
                                            FontSize="12.5"
                                            Content="{loc:Loc BtnOpenLangFolder}"
                                            Command="{Binding OpenLangFolderCommand}" />
                                </StackPanel>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="{loc:Loc LabelAppLanguage}" FontWeight="SemiBold" FontSize="13.5" />
                                    <TextBlock Text="{loc:Loc DescAppLanguage}" Style="{StaticResource DescTextStyle}" />
                                </StackPanel>
                            </DockPanel>

                            <Border Background="{DynamicResource SurfaceElevatedBrush}"
                                    CornerRadius="{DynamicResource ControlCornerRadius}"
                                    Padding="10,8"
                                    Margin="0,12,0,0"
                                    Visibility="{DynamicResource DescVisibility}">
                                <TextBlock Text="{loc:Loc HintCustomLangFile}"
                                           VerticalAlignment="Center"
                                           FontSize="12"
                                           Foreground="{DynamicResource SecondaryForegroundBrush}"
                                           TextWrapping="Wrap" />
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
