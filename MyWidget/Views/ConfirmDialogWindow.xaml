<Window x:Class="MyWidget.Views.ConfirmDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:MyWidget.Services"
        Title="{Binding TitleText}"
        Width="420"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="Window_OnPreviewKeyDown">

    <Border Margin="14"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource ControlBorderBrush}"
            BorderThickness="1"
            CornerRadius="{DynamicResource CardCornerRadius}"
            Padding="20,18"
            MouseLeftButtonDown="RootBorder_OnMouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18"
                              ShadowDepth="4"
                              Direction="270"
                              Opacity="0.32"
                              Color="#000000" />
        </Border.Effect>

        <StackPanel>
            <!-- Top Row: Icon + Title + Close Button -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border x:Name="IconBadge"
                        Grid.Column="0"
                        Width="38"
                        Height="38"
                        CornerRadius="{DynamicResource ControlCornerRadius}"
                        Background="{DynamicResource DangerSoftBrush}"
                        Margin="0,0,12,0"
                        VerticalAlignment="Top">
                    <TextBlock x:Name="IconGlyph"
                               Text="🗑"
                               FontSize="17"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="DialogTitleText"
                               FontSize="15.5"
                               FontWeight="Bold"
                               Foreground="{DynamicResource ForegroundBrush}"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="DialogMessageText"
                               Margin="0,6,0,0"
                               FontSize="13"
                               Foreground="{DynamicResource SecondaryForegroundBrush}"
                               TextWrapping="Wrap"
                               LineHeight="19" />
                </StackPanel>

                <Button Grid.Column="2"
                        Style="{StaticResource GhostIconButtonStyle}"
                        VerticalAlignment="Top"
                        Content="✕"
                        FontSize="12"
                        Padding="6,3"
                        Click="CancelBtn_OnClick" />
            </Grid>

            <!-- Action Buttons -->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,20,0,0">
                <Button x:Name="CancelButton"
                        Style="{StaticResource SecondaryButtonStyle}"
                        MinWidth="88"
                        Padding="14,8"
                        Margin="0,0,8,0"
                        Content="{loc:Loc BtnCancel}"
                        Click="CancelBtn_OnClick" />

                <Button x:Name="ConfirmButton"
                        MinWidth="96"
                        Padding="16,8"
                        FontWeight="SemiBold"
                        FontSize="13"
                        Cursor="Hand"
                        Click="ConfirmBtn_OnClick">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="{DynamicResource ControlCornerRadius}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.88" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.76" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
