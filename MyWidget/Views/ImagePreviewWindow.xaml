<Window x:Class="MyWidget.Views.ImagePreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:MyWidget.Services"
        Title="{loc:Loc PreviewImageTitle}"
        Width="860"
        Height="620"
        MinWidth="420"
        MinHeight="320"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource ForegroundBrush}"
        PreviewKeyDown="Window_OnPreviewKeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource SubtleBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="14,0">
            <DockPanel LastChildFill="False">
                <TextBlock x:Name="FileNameText"
                           DockPanel.Dock="Left"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           FontSize="13"
                           TextTrimming="CharacterEllipsis"
                           MaxWidth="480" />

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource SecondaryButtonStyle}"
                            Padding="10,4"
                            Margin="0,0,6,0"
                            Content="−"
                            Click="ZoomOut_OnClick" />
                    <TextBlock x:Name="ZoomLabel"
                               Text="100%"
                               Width="52"
                               TextAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="12.5" />
                    <Button Style="{StaticResource SecondaryButtonStyle}"
                            Padding="10,4"
                            Margin="6,0,8,0"
                            Content="+"
                            Click="ZoomIn_OnClick" />
                    <Button Style="{StaticResource SecondaryButtonStyle}"
                            Padding="10,4"
                            Margin="0,0,8,0"
                            Content="1:1"
                            Click="ResetZoom_OnClick" />
                    <Button Style="{StaticResource PrimaryButtonStyle}"
                            Padding="12,5"
                            Content="{loc:Loc BtnOpenExternalViewer}"
                            Click="OpenExternal_OnClick" />
                </StackPanel>
            </DockPanel>
        </Border>

        <ScrollViewer Grid.Row="1"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"
                      PreviewMouseWheel="ScrollViewer_OnPreviewMouseWheel"
                      Background="{DynamicResource WindowBackgroundBrush}">
            <Grid Margin="16">
                <Image x:Name="PreviewImg"
                       Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center">
                    <Image.LayoutTransform>
                        <ScaleTransform x:Name="ImgScale" ScaleX="1" ScaleY="1" />
                    </Image.LayoutTransform>
                </Image>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
