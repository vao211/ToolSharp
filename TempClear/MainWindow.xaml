<Window x:Class="TempClear.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TempClear"
        xmlns:tempClear="clr-namespace:TempClear"
        Title="Lmao Temp Cleaner" Height="450" Width="620"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource ForegroundBrush}">
    <Window.Resources>
        <local:InverseBooleanConverter x:Key="InverseBooleanConverter" />
    </Window.Resources>
    <Window.DataContext>
        <tempClear:MainViewModel />
    </Window.DataContext>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Button Content="Chọn tất cả" Command="{Binding SelectAllCommand}" Margin="0,0,6,0" />
                <Button Content="Bỏ chọn tất cả" Command="{Binding DeselectAllCommand}" Margin="0,0,6,0" />
                <Button Content="Tải lại danh sách" Command="{Binding ReloadCommand}" />
            </StackPanel>

            <ToggleButton Grid.Column="1"
                          Style="{StaticResource ThemeToggleStyle}"
                          Content="Dark Mode"
                          IsChecked="{Binding IsDarkMode, Mode=TwoWay}"
                          Margin="10,0,0,0" />
        </Grid>

        <ListView Grid.Row="1" ItemsSource="{Binding Folders}">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Chọn" Width="55">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsSelected}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Tên Thư Mục" Width="250" DisplayMemberBinding="{Binding Name}" />
                    <GridViewColumn Header="Ngày tạo" Width="150" DisplayMemberBinding="{Binding CreatedDate}" />
                    <GridViewColumn Header="Dung lượng" DisplayMemberBinding="{Binding DisplaySize}" Width="105" />
                </GridView>
            </ListView.View>
        </ListView>

        <StackPanel Grid.Row="2" Margin="0,10,0,0">
            <TextBlock Text="{Binding StatusMessage}" FontWeight="Bold" Margin="0,0,0,6" />
            <ProgressBar Height="18" Value="{Binding ProgressValue}" Maximum="100" />
        </StackPanel>

        <Button Grid.Row="3" Content="XÓA CÁC MỤC ĐÃ CHỌN"
                Command="{Binding DeleteCommand}"
                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"
                Style="{StaticResource DangerButtonStyle}"
                Margin="0,10,0,0" />
    </Grid>
</Window>