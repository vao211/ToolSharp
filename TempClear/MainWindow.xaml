<Window x:Class="TempClear.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TempClear"
        xmlns:tempClear="clr-namespace:TempClear"
        Title="Lmao Temp Cleaner" Height="450" Width="600"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <local:InverseBooleanConverter x:Key="InverseBooleanConverter" />
    </Window.Resources>
    <Window.DataContext>
        <tempClear:MainViewModel />
    </Window.DataContext>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="Chọn tất cả" Command="{Binding SelectAllCommand}" Padding="10,5" Margin="0,0,5,0" />
            <Button Content="Bỏ chọn tất cả" Command="{Binding DeselectAllCommand}" Padding="10,5" Margin="0,0,5,0" />
            <Button Content="Tải lại danh sách" Command="{Binding ReloadCommand}" Padding="10,5" />
        </StackPanel>

        <ListView Grid.Row="1" ItemsSource="{Binding Folders}" BorderBrush="Gray" BorderThickness="1">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Chọn" Width="50">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsSelected}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Tên Thư Mục" Width="250" DisplayMemberBinding="{Binding Name}" />
                    <GridViewColumn Header="Ngày tạo" Width="150" DisplayMemberBinding="{Binding CreatedDate}" />
                    <GridViewColumn Header="Dung lượng" DisplayMemberBinding="{Binding DisplaySize}" Width="100" />
                </GridView>
            </ListView.View>
        </ListView>

        <StackPanel Grid.Row="2" Margin="0,10,0,0">
            <TextBlock Text="{Binding StatusMessage}" FontWeight="Bold" Margin="0,0,0,5" />
            <ProgressBar Height="20" Value="{Binding ProgressValue}" Maximum="100" />
        </StackPanel>

        <Button Grid.Row="3" Content="XÓA CÁC MỤC ĐÃ CHỌN"
                Command="{Binding DeleteCommand}"
                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"
                Background="#FFDD4B39" Foreground="White" FontWeight="Bold"
                Padding="10" Margin="0,10,0,0" />
    </Grid>
</Window>